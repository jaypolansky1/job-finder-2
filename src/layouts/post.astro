---
// Simple layout for posts
const { title } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <article>
        <slot />
      </article>
      <p><a href="/">← Back</a></p>
    </main>
  </body>
</html>
